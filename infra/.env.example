# Environment Configuration for TRACE
# Copy to .env and fill in values before running docker-compose

# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace_dev_password
POSTGRES_DB=trace
DATABASE_URL=postgresql://trace:trace_dev_password@postgres:5432/trace

# ─── Neo4j ─────────────────────────────────────────────────
NEO4J_AUTH=neo4j/trace_neo4j_dev
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trace_neo4j_dev

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production-too
JWT_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

# ─── LLM (optional — system degrades gracefully if unset) ─
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ─── spaCy ─────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm

# ─── File Storage ──────────────────────────────────────────
UPLOAD_DIR=/uploads

# ─── API ───────────────────────────────────────────────────
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# ─── Neo4j demo seed ───────────────────────────────────────
# true  (default): neo4j-init clears + reseeds the fictional demo case on every
#                  startup (idempotent; safe on persistent volumes).
# false          : skip demo data; existing graph content is left untouched.
TRACE_RESEED_DEMO=true
